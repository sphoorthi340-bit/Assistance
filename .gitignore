# Jarvis V3 — Git Ignore Rules

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environment ---
venv/
.venv/
env/

# --- Runtime Data (generated, not tracked) ---
data/*.db
data/*.db-wal
data/*.db-shm
vector_db/
vector_db_backup_*/
logs/*.log

# --- Sensitive Config ---
.env

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Test / Scratch ---
cleanup_test.py
test_phase2.py
