# Jarvis V3.0 — Environment Variables
# ====================================
# Copy this file to .env and fill in your values.
# These values OVERRIDE anything in configs/config.yaml.
# All cloud API keys are optional — Jarvis works fully offline with local models.

# ============================================================
# Cloud API Keys (Phase 3 — optional)
# ============================================================
# Uncomment and fill in to enable cloud providers.

# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Operating Mode (Phase 3)
# ============================================================
# Development mode: cloud-preferred routing (quality-first)
# Production mode: local-preferred routing (privacy-first)

# JARVIS_DEVELOPMENT_MODE=true
# JARVIS_OFFLINE_MODE=false

# ============================================================
# Local Inference
# ============================================================

# JARVIS_LLM_MODEL=qwen2.5:7b
# JARVIS_OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# Database & Storage
# ============================================================

# JARVIS_DB_PATH=data/jarvis.db
# JARVIS_CHROMADB_PATH=vector_db
# JARVIS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================
# Context Retrieval
# ============================================================

# JARVIS_MAX_RETRIEVED_MEMORIES=3
# JARVIS_MAX_CONTEXT_TOKENS=500
# JARVIS_CONVERSATION_HISTORY_TURNS=10

# ============================================================
# Logging
# ============================================================

# JARVIS_LOG_LEVEL=INFO
# JARVIS_LOG_DIR=logs

# ============================================================
# Cloud Budget (Phase 3)
# ============================================================

# JARVIS_CLOUD_DAILY_BUDGET=20
