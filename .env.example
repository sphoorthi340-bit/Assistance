# Jarvis V1 — Environment Variables
# ====================================
# Copy this file to .env and modify as needed.
# These values OVERRIDE settings in configs/config.yaml.

# --- LLM ---
# JARVIS_LLM_MODEL=deepseek-r1:7b
# JARVIS_OLLAMA_BASE_URL=http://localhost:11434

# --- Database ---
# JARVIS_DB_PATH=data/jarvis.db

# --- Vector Memory ---
# JARVIS_CHROMADB_PATH=vector_db
# JARVIS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Logging ---
# JARVIS_LOG_LEVEL=INFO
# JARVIS_LOG_DIR=logs

# --- Context Retrieval ---
# JARVIS_MAX_RETRIEVED_MEMORIES=3
# JARVIS_MAX_CONTEXT_TOKENS=500
# JARVIS_CONVERSATION_HISTORY_TURNS=10
